<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top bar: App Brand / Launcher Header & Cycle Habit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_header_launch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tide"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#636366"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_habit_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Smoking"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_goal_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="QUIT"
            android:textColor="#0A84FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_next_habit"
            android:layout_width="32dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_secondary"
            android:text="⇄"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Progress / Metrics Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 / 10 Cigarettes"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Allowance: 6 left today"
            android:textColor="#8E8E93"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_log"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_primary"
            android:text="+1 Log"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_craving"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:text="Craving"
            android:textAllCaps="false"
            android:textColor="#FF9F0A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_btn_undo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.8"
            android:background="@drawable/widget_button_secondary"
            android:text="↶ Undo"
            android:textAllCaps="false"
            android:textColor="#8E8E93"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
